<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions for Production Networking, Caching & Responsible Location Access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_dialog_map"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_dialog_map"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TransitPH">

        <!-- Launcher / Login Screen -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Registration Screen -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Home & Fragment Container -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Route Search Results -->
        <activity
            android:name=".activities.RouteResultsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Route Details & Visual Timeline -->
        <activity
            android:name=".activities.RouteDetailsActivity"
            android:exported="false" />

        <!-- Terminal Details & Routes -->
        <activity
            android:name=".activities.TerminalDetailsActivity"
            android:exported="false" />

        <!-- Destination & Landmark Discovery -->
        <activity
            android:name=".activities.DestinationDiscoveryActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Commuter Safety & Incident Reporting -->
        <activity
            android:name=".activities.SafetyReportsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Premium Subscription & Upgrade -->
        <activity
            android:name=".activities.PremiumUpgradeActivity"
            android:exported="false" />

        <!-- Admin Dashboard -->
        <activity
            android:name=".activities.AdminDashboardActivity"
            android:exported="false" />

        <!-- Admin Terminal CRUD -->
        <activity
            android:name=".activities.ManageTerminalsActivity"
            android:exported="false" />

        <!-- Admin Route CRUD -->
        <activity
            android:name=".activities.ManageRoutesActivity"
            android:exported="false" />

        <!-- Admin Destination CRUD -->
        <activity
            android:name=".activities.ManageDestinationsActivity"
            android:exported="false" />

        <!-- Admin Safety Reports Moderation -->
        <activity
            android:name=".activities.ManageReportsActivity"
            android:exported="false" />

        <!-- Interactive Map (OpenStreetMap) -->
        <activity
            android:name=".activities.MapActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
